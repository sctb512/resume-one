  "page": {
    "size": "A4",
    "firstLinePosition": "line-box",
    "sectionGapMm": 6.1,
    "marginsMm": {
      "top": 19,
      "right": 19,
      "bottom": 17,
      "left": 19
    },
    "avoidSplitItems": true,
    "keepHeadingWithFirstItem": true
  },
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.5,
      "lineHeight": 1.46,
      "weight": 400
    },
    "name": {
      "family": "cjk-sans",
      "weight": 400,
      "sizePt": 32,
      "lineHeight": 1.16
    },
    "label": {
      "sizePt": 11.2,
      "lineHeight": 1.3,
      "weight": 400,
      "family": "cjk-sans"
    },
    "sectionTitle": {
      "family": "cjk-sans",
      "sizePt": 12.6,
      "weight": 400,
      "lineHeight": 1.25
    },
    "itemTitle": {
      "sizePt": 11,
      "weight": 400,
      "lineHeight": 1.34,
      "family": "cjk-sans"
    },
    "meta": {
      "sizePt": 9.4,
      "lineHeight": 1.38
    },
    "sideDate": {
      "sizePt": 9.3,
      "lineHeight": 1.35
    }
  },
  "composition": {
    "preset": "split-header",
    "header": "split",
    "contact": "stacked",
    "moduleOrder": [
