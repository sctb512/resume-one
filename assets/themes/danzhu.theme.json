{
  "formatVersion": 2,
  "id": "danzhu",
  "name": "丹朱",
  "description": "朱砂细线 · 分栏页眉",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "layout": "rules",
  "colors": {
