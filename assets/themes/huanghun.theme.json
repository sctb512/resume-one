{
  "formatVersion": 2,
  "id": "huanghun",
  "name": "黄昏",
  "description": "暖铜时间线 · 项目优先",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "layout": "rules",
  "colors": {
    "accent": "#89472F",
    "seal": "#89472F",
    "paper": "#FFFCF8",
    "canvas": "#F5ECE4"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "page": {
    "size": "A4",
    "firstLinePosition": "line-box",
    "sectionGapMm": 6.1,
    "marginsMm": {
      "top": 18,
      "right": 20,
      "bottom": 17,
      "left": 20
    },
    "avoidSplitItems": true,
    "keepHeadingWithFirstItem": true
  },
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.5,
      "lineHeight": 1.46,
      "weight": 400
    },
    "name": {
      "family": "cjk-serif",
      "weight": 600,
      "sizePt": 35,
      "lineHeight": 1.16
    },
    "label": {
      "sizePt": 11.2,
      "lineHeight": 1.3,
      "weight": 400,
      "family": "cjk-sans"
    },
    "sectionTitle": {
      "family": "cjk-serif",
      "sizePt": 12.6,
      "weight": 600,
      "lineHeight": 1.25
    },
    "itemTitle": {
      "sizePt": 11,
      "weight": 400,
      "lineHeight": 1.34,
      "family": "cjk-sans"
    },
    "meta": {
      "sizePt": 9.4,
      "lineHeight": 1.38
    },
    "sideDate": {
      "sizePt": 9.3,
      "lineHeight": 1.35
    }
  },
  "composition": {
    "preset": "single-column",
    "header": "stacked",
    "contact": "inline",
    "moduleOrder": [
      "projects",
      "work",
      "skills",
      "education"
    ]
  },
  "sections": {
    "work": {
      "heading": "accent-line",
      "items": "timeline",
      "date": "inline"
    },
    "volunteer": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "education": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "awards": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "certificates": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "publications": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "skills": {
      "heading": "accent-line",
      "items": "compact",
      "date": "inline"
    },
    "languages": {
      "heading": "accent-line",
      "items": "compact",
      "date": "inline"
    },
    "interests": {
      "heading": "accent-line",
      "items": "compact",
      "date": "inline"
    },
    "references": {
      "heading": "accent-line",
      "items": "stack",
      "date": "inline"
    },
    "projects": {
      "heading": "accent-line",
      "items": "timeline",
      "date": "inline"
    }
  },
  "provenance": {
    "upstreamUrl": "https://docs.rendercv.com/user_guide/yaml_input_structure/design/",
    "fidelity": "inspired"
  }
}
