    "label": {
      "sizePt": 10.5,
      "lineHeight": 1.3,
      "weight": 400,
      "family": "cjk-sans"
    },
    "sectionTitle": {
      "family": "cjk-sans",
      "sizePt": 12,
      "weight": 400,
      "lineHeight": 1.25
