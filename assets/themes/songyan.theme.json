{
  "formatVersion": 2,
  "id": "songyan",
  "name": "松烟",
  "description": "经典衬线 · 教育优先",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "layout": "classic",
  "colors": {
    "accent": "#222B27",
    "seal": "#814437",
    "paper": "#FFFFFF",
    "canvas": "#F0EFE8"
