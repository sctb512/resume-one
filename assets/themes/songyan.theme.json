    },
    "education": {
      "heading": "plain",
      "items": "compact",
      "date": "right"
    },
    "awards": {
      "heading": "plain",
      "items": "compact",
      "date": "right"
    },
    "certificates": {
      "heading": "plain",
      "items": "compact",
      "date": "inline"
    },
    "publications": {
      "heading": "plain",
      "items": "compact",
      "date": "right"
    },
    "skills": {
      "heading": "plain",
      "items": "compact",
      "date": "inline"
    },
    "languages": {
      "heading": "plain",
      "items": "compact",
      "date": "inline"
    },
    "interests": {
      "heading": "plain",
      "items": "compact",
      "date": "inline"
    },
    "references": {
      "heading": "plain",
