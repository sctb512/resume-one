  "page": {
    "size": "Letter",
    "firstLinePosition": "line-box",
    "sectionGapMm": 4.6,
    "marginsMm": {
      "top": 17,
      "right": 18,
      "bottom": 15,
      "left": 18
    },
    "avoidSplitItems": true,
    "keepHeadingWithFirstItem": true
  },
  "typography": {
    "body": {
      "family": "cjk-serif",
      "sizePt": 10.2,
      "lineHeight": 1.34,
      "weight": 600
    },
    "name": {
      "family": "cjk-serif",
      "weight": 600,
      "sizePt": 28,
      "lineHeight": 1.16
    },
    "label": {
      "sizePt": 10.5,
      "lineHeight": 1.3,
      "weight": 400,
      "family": "cjk-sans"
    },
    "sectionTitle": {
      "family": "cjk-serif",
      "sizePt": 12,
      "weight": 600,
      "lineHeight": 1.25,
      "textTransform": "uppercase",
      "trackingEm": 0.065
    },
    "itemTitle": {
      "sizePt": 10.5,
      "weight": 400,
      "lineHeight": 1.34,
      "family": "cjk-sans"
    },
    "meta": {
      "sizePt": 9.0,
      "lineHeight": 1.38
    },
    "sideDate": {
      "sizePt": 8.8,
      "lineHeight": 1.35
    }
  },
  "composition": {
    "preset": "single-column",
    "header": "centered",
    "contact": "inline",
    "moduleOrder": [
      "education",
      "work",
      "volunteer",
      "skills"
    ]
  },
  "sections": {
    "work": {
      "heading": "plain",
      "items": "compact",
      "date": "right"
