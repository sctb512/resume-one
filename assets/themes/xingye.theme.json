{
  "formatVersion": 2,
  "id": "xingye",
  "name": "行野",
  "description": "深蓝细线 · 技术项目优先",
  "version": "1.3.0",
  "license": "Apache-2.0",
  "layout": "minimal",
  "colors": {
    "accent": "#314870",
    "seal": "#874C42",
    "paper": "#FFFFFF",
    "canvas": "#EDF0F7"
  },
  "modules": [
    "basics",
    "work",
    "volunteer",
    "education",
    "awards",
    "certificates",
    "publications",
    "skills",
    "languages",
    "interests",
    "references",
    "projects"
  ],
  "page": {
    "size": "Letter",
    "firstLinePosition": "line-box",
    "sectionGapMm": 4.6,
    "marginsMm": {
      "top": 15,
      "right": 17,
      "bottom": 15,
      "left": 17
    },
    "avoidSplitItems": true,
    "keepHeadingWithFirstItem": true
  },
  "typography": {
    "body": {
      "family": "cjk-sans",
      "sizePt": 10.2,
      "lineHeight": 1.34,
      "weight": 400
    },
    "name": {
      "family": "cjk-sans",
      "weight": 400,
      "sizePt": 30,
      "lineHeight": 1.16
    },
    "label": {
      "sizePt": 10.5,
      "lineHeight": 1.3,
      "weight": 400,
      "family": "cjk-sans"
    },
    "sectionTitle": {
      "family": "cjk-sans",
      "sizePt": 12,
      "weight": 400,
      "lineHeight": 1.25,
      "textTransform": "uppercase",
      "trackingEm": 0.065
    },
    "itemTitle": {
      "sizePt": 10.5,
      "weight": 600,
      "lineHeight": 1.34,
      "family": "cjk-serif"
    },
    "meta": {
      "sizePt": 9.0,
      "lineHeight": 1.38
    },
    "sideDate": {
      "sizePt": 8.8,
      "lineHeight": 1.35
    }
  },
  "composition": {
    "preset": "split-header",
    "header": "split",
    "contact": "stacked",
    "moduleOrder": [
      "projects",
      "work",
      "education",
      "skills"
    ]
  },
  "sections": {
    "work": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    },
    "volunteer": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    },
    "education": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    },
    "awards": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    },
    "certificates": {
      "heading": "line",
      "items": "compact",
      "date": "inline"
    },
    "publications": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    },
    "skills": {
      "heading": "line",
      "items": "compact",
      "date": "inline"
    },
    "languages": {
      "heading": "line",
      "items": "compact",
      "date": "inline"
    },
    "interests": {
      "heading": "line",
      "items": "compact",
      "date": "inline"
    },
    "references": {
      "heading": "line",
      "items": "compact",
      "date": "inline"
    },
    "projects": {
      "heading": "line",
      "items": "compact",
      "date": "right"
    }
  },
  "provenance": {
    "upstreamUrl": "https://docs.rendercv.com/user_guide/yaml_input_structure/design/",
    "fidelity": "inspired"
  }
}
