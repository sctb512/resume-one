{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume One Declarative Theme Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "name", "layout", "colors", "modules"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 240 },
    "layout": { "enum": ["classic", "rules", "minimal", "modern"] },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accent", "seal", "paper", "canvas"],
      "properties": {
        "accent": { "$ref": "#/definitions/color" },
        "seal": { "$ref": "#/definitions/color" },
        "paper": { "$ref": "#/definitions/color" },
        "canvas": { "$ref": "#/definitions/color" }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/moduleId" }
    }
  },
  "definitions": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "moduleId": {
      "enum": ["basics", "work", "volunteer", "education", "awards", "certificates", "publications", "skills", "languages", "interests", "references", "projects"]
    }
  }
}
